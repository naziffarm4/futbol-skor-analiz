# Supabase Bağlantı Yapılandırması
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Varsayılan Sezon ve İstemci Ayarları
# DEFAULT_SEASON=  # Bos birakildiginda otomatik dinamik sezon (Temmuz itibariyla YIL-(YIL+1)) kullanilir
HTTP_TIMEOUT_SECONDS=30

# Manuel Senkronizasyon Uç Noktası Koruması (/sync, /api/v1/sync, ?refresh=true)
SYNC_API_KEY=your-secret-sync-api-key

# Resmi Futbol ve Piyasa Oran API Anahtarları
API_FOOTBALL_KEY=
THE_ODDS_API_KEY=
